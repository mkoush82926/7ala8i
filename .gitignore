# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/
/test-results
/playwright-report
/blob-report
/playwright/.cache
/e2e/.seed-data.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# local tool settings (shared settings live in .claude/settings.json)
.claude/settings.local.json

# supabase CLI local state
/supabase/.branches
/supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# raw asset drop-off — the actual files used by the app are copied into
# public/videos/, which IS committed; this is just the untouched original
/videoassets

# graphify — keep graph.json committed for teammates; skip heavy/derived output
graphify-out/cache/
graphify-out/graph.html
graphify-out/.graphify_labels.pending.json
