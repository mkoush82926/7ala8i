# ─────────────────────────────────────────────────────────────────────────────
# Halaqy environment variables. Copy to .env.local and fill in:
#
#   cp .env.example .env.local
#
# Every variable is read and validated in ONE place: src/lib/env.ts.
# NEXT_PUBLIC_* values are inlined into the browser bundle, so never put a
# secret in one. See docs/DEPLOYMENT.md for the production checklist.
#
# Local development / E2E tests run against a local Supabase stack, not a
# hosted project. Start it with `npm run db:start` (requires Docker), then
# copy the printed "API URL", "anon key" and "service_role key" below
# (or run `npx supabase status`). `npm run db:reset` re-applies
# supabase/migrations/ and supabase/seed.sql.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL and public anon key. Local default URL: http://127.0.0.1:54321
# A production server refuses to start when these are missing or malformed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser.
# Used only by the shared rate limiter (src/lib/rate-limit.ts, via the
# check_rate_limit RPC) and by scripts/seed-e2e.mjs. When unset, rate limits
# fall back to per-instance memory, which is NOT enough on Vercel (many
# instances), so set it in production.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (recommended) ───────────────────────────────────────────────────────
# Public origin of the app, without a trailing slash. Exposed to code as
# publicEnv.siteUrl for absolute links (auth emails, invite links). Keep it
# identical to the Supabase Auth "Site URL".
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=

# ── Mock preview mode (local development only) ───────────────────────────────
# "true" previews explore/shop/booking pages with realistic dummy data when
# local Supabase isn't running (no Docker needed). Works with `npm run dev`
# only: it is refused whenever NODE_ENV=production, so a local
# `next build && next start` (and Playwright) always runs against Supabase.
NEXT_PUBLIC_USE_MOCK_DATA=

# On top of the above: fake a signed-in session to preview auth-gated pages.
# One of: shop_admin | barber | customer. Ignored outside mock mode.
NEXT_PUBLIC_MOCK_AUTH_ROLE=

# Escape hatch that allows mock mode in a production build (e.g. a static
# design preview deploy). LEAVE UNSET. Never set it on a real deployment.
# NEXT_PUBLIC_ALLOW_MOCK_IN_PROD=

# ── CI / tooling ─────────────────────────────────────────────────────────────
# Set to 1 to skip the production env check, e.g. a CI `next build` that has
# no Supabase secrets. Never set it on a running production server.
# SKIP_ENV_VALIDATION=1

# Optional: point Playwright at an already-running app instead of building one.
# E2E_BASE_URL=http://127.0.0.1:3000
