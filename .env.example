# Copy to .env.local and fill in.
#
# Local development / E2E tests run against a local Supabase stack, not a
# hosted project. Start it with `npm run db:start` (requires Docker), then
# copy the printed "API URL", "anon key", and "service_role key" below.
# `npm run db:reset` re-applies supabase/migrations/ + seed.sql.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — set to "true" locally to preview the explore/shop/booking pages
# with realistic dummy data when local Supabase isn't running (no Docker
# needed). Leave unset everywhere else, including production.
NEXT_PUBLIC_USE_MOCK_DATA=
