# ─────────────────────────────────────────────────────────────────────────────
# Halaqy environment variables. Copy to .env.local and fill in:
#
#   cp .env.example .env.local
#
# Every variable is read and validated in ONE place: src/lib/env.ts.
# NEXT_PUBLIC_* values are inlined into the browser bundle, so never put a
# secret in one. See docs/DEPLOYMENT.md for the production checklist.
#
# Local development / E2E tests run against a local Supabase stack, not a
# hosted project. Start it with `npm run db:start` (requires Docker), then
# copy the printed "API URL", "anon key" and "service_role key" below
# (or run `npx supabase status`). `npm run db:reset` re-applies
# supabase/migrations/ and supabase/seed.sql.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (required) ──────────────────────────────────────────────────────
# Project URL and public anon key. Local default URL: http://127.0.0.1:54321
# A production server refuses to start when these are missing or malformed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY — never prefix with NEXT_PUBLIC_, never expose to the browser.
# Used by the shared rate limiter (src/lib/rate-limit.ts, via the
# check_rate_limit RPC), by scripts/seed-e2e.mjs and by the OTP "hook" mode. When unset, rate limits
# fall back to per-instance memory, which is NOT enough on Vercel (many
# instances), so set it in production.
SUPABASE_SERVICE_ROLE_KEY=

# ── Site (recommended) ───────────────────────────────────────────────────────
# Public origin of the app, without a trailing slash. Exposed to code as
# publicEnv.siteUrl for absolute links (auth emails, invite links). Keep it
# identical to the Supabase Auth "Site URL".
# Also the origin for canonical URLs, JSON-LD, the shop booking link and its
# QR code. Optional: falls back to VERCEL_PROJECT_PRODUCTION_URL, then
# VERCEL_URL (server) or window.location.origin (browser).
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_SITE_URL=

# ── Maps (optional) ──────────────────────────────────────────────────────────
# MapTiler key for the static shop map, the settings pin picker and the
# onboarding location step, and for the search results map (MapTiler
# streets-v2; the key must match [A-Za-z0-9_-]{8,128}). When unset, keyless
# OpenStreetMap raster tiles are used (with attribution) and nothing errors;
# if the map fails, the area centre and the landmark text are used instead and
# the results list keeps working.
NEXT_PUBLIC_MAPTILER_KEY=

# ── Booking phone verification (optional) ────────────────────────────────────
# off (default) | supabase | hook. "hook" silently degrades to off unless an
# OTP_PROVIDER and SUPABASE_SERVICE_ROLE_KEY are set.
NEXT_PUBLIC_OTP_MODE=
# sms (default) | whatsapp
NEXT_PUBLIC_OTP_CHANNEL=
# SERVER ONLY. unifonic | whatsapp | log ("log" is dev only; refused in production).
OTP_PROVIDER=
# Unifonic SMS (OTP_PROVIDER=unifonic). Sender ID defaults to "Halaqy".
UNIFONIC_APP_SID=
UNIFONIC_SENDER_ID=
# WhatsApp Cloud API (OTP_PROVIDER=whatsapp): an authentication template.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE=
# "v1,whsec_..." from the Supabase Auth Send-SMS hook, for /api/booking/otp/sms-hook.
SEND_SMS_HOOK_SECRET=

# ── Bot protection (optional) ────────────────────────────────────────────────
# Cloudflare Turnstile on public booking. Enabled only when BOTH are set.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Owner sign-up (optional) ─────────────────────────────────────────────────
# "true" turns on owner sign-up by phone with an SMS OTP in /start (needs an
# SMS provider in Supabase Auth). When unset, sign-up uses email + password
# and the phone is stored as the shop's WhatsApp contact.
NEXT_PUBLIC_PHONE_AUTH_ENABLED=

# ── Client messaging: WhatsApp / SMS (optional) ──────────────────────────────
# Confirmations, reminders and follow-ups (WS-1C). With nothing set, messages
# wait on Settings › Client messages as one-tap wa.me links and nothing errors.
# WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID (above) are shared with the OTP.
# Template name prefix; default halaqy_
WHATSAPP_TEMPLATE_PREFIX=
# Comma list of Meta-approved template ids, or "all". Unapproved templates
# fall back to manual wa.me sending.
WHATSAPP_TEMPLATES_APPROVED=
# SERVER ONLY. Enables signature checks on POST /api/messaging/whatsapp.
WHATSAPP_APP_SECRET=
# SERVER ONLY. Meta webhook verification handshake for /api/messaging/whatsapp.
WHATSAPP_VERIFY_TOKEN=
# SMS fallback uses UNIFONIC_APP_SID / UNIFONIC_SENDER_ID (above).
# SERVER ONLY. Shared secret for the inbound SMS webhook /api/messaging/sms.
MESSAGING_SMS_WEBHOOK_SECRET=
# SERVER ONLY. Bearer for /api/messaging/dispatch (falls back to CRON_SECRET).
# Set the same value as an Edge Function secret together with
# MESSAGING_DISPATCH_URL=https://<site>/api/messaging/dispatch.
MESSAGING_CRON_SECRET=
# Cost tracking per message in fils (defaults 12 / 45 / 25).
MESSAGING_COST_FILS_WA_UTILITY=
MESSAGING_COST_FILS_WA_MARKETING=
MESSAGING_COST_FILS_SMS=
# ── Staff push notifications (optional) ──────────────────────────────────────
# Web Push for barbers and owners (WS-1K). Without VAPID keys nothing is sent
# and nothing errors. Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
# SERVER ONLY.
VAPID_PRIVATE_KEY=
# Optional mirror of VAPID_PUBLIC_KEY for the browser.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# mailto: or https: contact; defaults to NEXT_PUBLIC_SITE_URL or https://halaqy.jo
VAPID_SUBJECT=
# SERVER ONLY. Shared secret for the pg_net kick to /api/push/dispatch. Then run
# once per environment:
#   SELECT public.set_push_dispatch_config('https://<site>/api/push/dispatch', '<secret>');
PUSH_DISPATCH_SECRET=
# SERVER ONLY. Vercel Cron bearer for /api/push/dispatch and the messaging
# dispatcher. Both dispatchers also need SUPABASE_SERVICE_ROLE_KEY.
CRON_SECRET=

# ── Error reporting (optional) ───────────────────────────────────────────────
# Sentry-compatible DSNs. Nothing is sent when unset; the app works the same.
# SERVER/EDGE: fetch-based reports from src/instrumentation.ts (onRequestError).
SENTRY_DSN=
# BROWSER: used by reportError() in the client error boundaries
# (src/app/[locale]/error.tsx, src/app/global-error.tsx). A DSN is public by design.
NEXT_PUBLIC_SENTRY_DSN=
# Event environment tag; defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
# Release tag, e.g. the deployed commit SHA.
SENTRY_RELEASE=

# ── Mock preview mode (local development only) ───────────────────────────────
# "true" previews explore/shop/booking pages with realistic dummy data when
# local Supabase isn't running (no Docker needed). Works with `npm run dev`
# only: it is refused whenever NODE_ENV=production, so a local
# `next build && next start` (and Playwright) always runs against Supabase.
NEXT_PUBLIC_USE_MOCK_DATA=

# On top of the above: fake a signed-in session to preview auth-gated pages.
# One of: shop_admin | barber | customer. Ignored outside mock mode.
NEXT_PUBLIC_MOCK_AUTH_ROLE=

# Escape hatch that allows mock mode in a production build (e.g. a static
# design preview deploy). LEAVE UNSET. Never set it on a real deployment.
# NEXT_PUBLIC_ALLOW_MOCK_IN_PROD=

# ── CI / tooling ─────────────────────────────────────────────────────────────
# Set to 1 to skip the production env check, e.g. a CI `next build` that has
# no Supabase secrets. Never set it on a running production server.
# SKIP_ENV_VALIDATION=1

# Optional: point Playwright at an already-running app instead of building one.
# E2E_BASE_URL=http://127.0.0.1:3000
